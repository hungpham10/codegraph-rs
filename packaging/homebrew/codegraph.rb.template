class Codegraph < Formula
  desc "Local-first code intelligence: tree-sitter knowledge graph + MCP server"
  homepage "https://github.com/hungpham10/codegraph-rs"
  version "@@VERSION@@"
  license "MIT"

  # Build from source so macOS Gatekeeper / antivirus don't flag an unsigned
  # prebuilt binary. Homebrew compiles it locally (Rust is provided below).
  url "https://github.com/hungpham10/codegraph-rs/archive/refs/tags/@@TAG@@.tar.gz"
  sha256 "@@SRC_SHA@@"

  depends_on "rust" => :build

  def install
    system "cargo", "build", "--release", "--locked", "-p", "codegraph"
    bin.install "target/release/codegraph"
  end

  test do
    assert_match "codegraph", shell_output("#{bin}/codegraph --version")
  end
end
